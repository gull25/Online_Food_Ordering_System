# Values read by docker-compose.yml. Copy to `.env` and change the passwords.
# These only take effect on the FIRST `docker compose up` (when the data volume
# is empty). To change them later: `docker compose down -v` and start again.

MONGO_PORT=27017
MONGO_DB=foodora

# Root/admin account
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpassword

# Application account used by the API (readWrite on MONGO_DB only)
MONGO_APP_USER=foodora_app
MONGO_APP_PASSWORD=foodora_app_password

# mongo-express (only started with: docker compose --profile tools up -d)
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
