PORT=5000
# Dockerised MongoDB (see docker-compose.yml at the repo root).
# Credentials must match MONGO_APP_USER / MONGO_APP_PASSWORD in the root .env,
# and authSource must be the app database the user was created in.
MONGO_URI=mongodb://foodora_app:foodora_app_password@localhost:27017/foodora?authSource=foodora
# Local MongoDB without auth:
# MONGO_URI=mongodb://localhost:27017/foodora
# JWT_SECRET MUST be a strong, random 64-character hex string in production
# E.g. generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_dev_key
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional. Without these the server still boots; only the card-payment
# routes respond 503. Get test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
