NODE_ENV=development
PORT=5000

# Local Docker Mongo (docker compose up -d):
# MONGO_URI=mongodb://foodora_app:foodora_app_password@localhost:27017/foodora?authSource=foodora
MONGO_URI=mongodb://localhost:27017/foodora

# Was literally "secretkey123" — the same string three modules used as a
# hardcoded fallback, so every session token was forgeable by anyone who read
# this repository. Regenerate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_generate_with_node_crypto_randomBytes_48
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:5173
# Extra browser origins allowed through CORS, comma separated.
CORS_ORIGINS=

LOG_LEVEL=dev
# Set to true only when the app really sits behind a reverse proxy.
TRUST_PROXY=false

# ── Optional integrations ────────────────────────────────────────────────────
# Image hosting. Without these, uploads store a placeholder reference.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Card payments. Card routes answer 503 until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Wallet gateways. Their callback endpoints reject every request until the
# shared secret is set — the callbacks used to confirm orders as paid on the
# caller's word alone.
EASYPAISA_HASH_KEY=
JAZZCASH_INTEGRITY_SALT=

# Transactional email. Without these, mail is logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Foodora
FROM_EMAIL=noreply@foodora.com

# Nominatim requires a real contact address in the User-Agent.
GEOCODER_USER_AGENT=Foodora/1.0 (support@foodora.example)
